# Reference names only. This core-PHP app loads config/env.php (not a dotenv parser).
# Copy config/env.example.php to config/env.php and set these PHP array entries.
ELEVENLABS_WEBHOOK_SECRET=
# SHOP_AGENT_MAP is a PHP associative array: real agent_id => shop_id.
SHOP_AGENT_MAP={"REPLACE_WITH_PANIPURI_AGENT_ID":"panipuri_stall_01","REPLACE_WITH_GROCERY_AGENT_ID":"grocery_store_02"}
# Voice IDs remain in config/shops/*.json, under languages.<code>.voice.options.
